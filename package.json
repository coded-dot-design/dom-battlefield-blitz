{
  "name": "@coded-design/dom-battlefield-blitz",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "description": "Battlefield Blitz: free-for-all tank chaos on any web page. The arcade version of DOM Battlefield, built on the Fizlet engine.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "check": "npm run build",
    "size": "node scripts/size.mjs",
    "test": "node --expose-gc --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs && node tests/pause.mjs",
    "test:replay": "node tests/determinism.mjs",
    "test:lockstep": "node tests/lockstep.mjs",
    "site:dev": "astro dev --config site/astro.config.mjs",
    "site:build": "astro build --config site/astro.config.mjs && node scripts/pages.mjs",
    "test:site": "node tests/site.mjs && node tests/multiplayer.mjs && node tests/phone.mjs"
  },
  "devDependencies": {
    "astro": "7.4.2",
    "esbuild": "0.28.2",
    "playwright": "1.58.2",
    "typescript": "7.0.2"
  }
}
