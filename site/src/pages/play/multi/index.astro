    letter-spacing: 0.08em;
    color: var(--k-attack);
  }
  .fine {
    margin: 0;
    font: 12px/1.45 var(--mono);
    color: var(--muted);
  }
  /* Seats and the per-player scoreboard: each seat's swatch is its tank's colour. */
  /* Swatches, seats and rows are written by the script: :global, so the scoped styles reach them. */
  :global(.room .sw) {
    display: inline-block;
    flex: none;
    width: 14px;
    height: 14px;
    margin-right: 8px;
    vertical-align: -2px;
