  }
  .rooms {
    display: grid;
    grid-template-columns: 48px 52px 48px;
    align-items: center;
    gap: 8px;
  }
  .room .pick .bui-key {
    width: 48px;
    height: 48px;
    min-height: 48px;
    padding: 0;
    font: 900 20px/1 var(--mono);
  }
  .rooms output {
    font: 900 26px/1 var(--mono);
    text-align: center;
    color: var(--ink);
  }
  /* The kit's sticker key, laid out as a wide row key (icon + word) for the card. */
  .room .step .bui-sticker-key {
    display: inline-flex;
