---
// Battlefield Blitz, the game: the arena fills the screen under the Battlefield header.
// The game code is this repo's committed build (dist/blitz.mjs).
import Base from '../../layouts/Base.astro';
import { base, BATTLEFIELD } from '../../site';
import { playLd } from '../../schema';
const title = 'Play Battlefield Blitz';
const description = 'Battlefield Blitz: free-for-all tank chaos. Parachute in, grab the blinking power tiles, call airstrikes. Most kills in three minutes wins.';
---
<Base title={title} description={description} page="play" app jsonld={playLd(Astro.site, title, description)}>
  <section class="blitz-stage" aria-labelledby="blitz-play-title">
    <h1 id="blitz-play-title" class="blitz-title">Play Battlefield Blitz</h1>
    <div id="blitz" class="blitz-host"></div>
  </section>
  <div class="wrap blitz-bar">
    <div class="blitz-keys">
      <h2 id="blitz-keys"><b>BLITZ</b> KEYS</h2>
      <ul aria-labelledby="blitz-keys">
        <li><kbd>WASD</kbd> / <kbd>arrows</kbd> drive</li>
        <li><kbd>mouse</kbd> aim, or <kbd>Q</kbd> auto-aim · <kbd>T</kbd> aim lock</li>
        <li><kbd>Space</kbd> / <kbd>click</kbd> fire</li>
        <li><kbd>E</kbd> long shot</li>
        <li><kbd>F</kbd> airstrike, then <kbd>Enter</kbd> (your target) or click the spot</li>
        <li><kbd>Esc</kbd> pause · cancel a strike · resume</li>
        <li><kbd>Tab</kbd> / <kbd>Enter</kbd> the on-screen keys</li>
        <li>Phones: drag left to drive</li>
      </ul>
    </div>
    <p><a href={base()}>About Blitz</a> · <a href={base('#drop')}>Put it on your site</a> · <a href={BATTLEFIELD}>The original: DOM Battlefield</a></p>
  </div>
</Base>

<script>
  import { createBlitz } from "../../../../dist/blitz.mjs";
  const seconds = Number(new URLSearchParams(location.search).get("seconds")) || 180;
  (window as unknown as { blitz: unknown }).blitz = createBlitz(document.getElementById("blitz")!, { mode: "board", seconds });
</script>

<style>
  /* Page heading for screen readers and outlines; the arena is the visible title. */
  .blitz-title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .blitz-stage {
    position: relative;
    height: calc(100svh - 78px);
    min-height: 420px;
    border-bottom: 2px solid var(--line);
    background: #090818;
  }
  .blitz-host {
    position: absolute;
    inset: 0;
  }
  .blitz-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 18px;
    padding-bottom: 6px;
    font: 12px var(--mono);
    color: var(--muted);
  }
  .blitz-bar p {
    margin: 0;
  }
  .blitz-keys h2 {
    margin: 0 0 6px;
    font: inherit;
    color: var(--ink);
  }
  .blitz-keys ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 13px;
    line-height: 1.7;
    color: var(--ink);
  }
  .blitz-bar b {
    color: var(--k-attack);
  }
  .blitz-bar a {
    color: var(--k-sys-ink);
  }
  /* Phones: the game is the whole screen, like the Battlefield app. No header, footer, scroll or zoom. */
  @media (pointer: coarse), (max-width: 760px) {
    :global(html:has(body[data-app])),
    :global(body[data-app]) {
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
      touch-action: none;
      -webkit-text-size-adjust: 100%;
    }
    :global(body[data-app] :is(.site-head, .site-foot, .skip)),
    .blitz-bar {
      display: none;
    }
    .blitz-stage {
      position: fixed;
      inset: 0;
      height: auto;
      min-height: 0;
      border: 0;
    }
  }
  kbd {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
  }
</style>
