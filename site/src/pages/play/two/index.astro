---
// The multiplayer page moved to /play/multi/ (2 to 4 players). Old links and shared invites still
// land there: the query (room, mode, code) and the hash are carried over.
import { base } from '../../../site';
const to = base('play/multi/');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex" />
<meta name="referrer" content="no-referrer" />
<title>Battlefield Blitz · multiplayer</title>
<link rel="canonical" href={new URL(to, Astro.site)} />
<script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
<meta http-equiv="refresh" content={`0;url=${to}`} />
</head>
<body style="background:#07060f;color:#f6f3ff;font:16px ui-monospace,monospace">
<p>Multiplayer moved: <a href={to} style="color:#19f0ff">play/multi/</a></p>
</body>
</html>
