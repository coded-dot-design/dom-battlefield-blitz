---
<svg viewBox="0 0 20 20" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" stroke-linejoin="miter" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label}><path d={d} /></svg>
