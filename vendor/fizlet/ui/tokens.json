{
  "name": "DOM VIRUS Board UI",
  "version": "1.0.0",
  "source": "DOM Battlefield 0.18.4 (dom-battlefield/src/style.css), extracted to board-ui/board-ui.css",
  "palette": {
    "note": "The only per-game input. Pass any subset to applyPalette(root, palette) or set the CSS variable directly. Hex only.",
    "roles": {
      "sys":     { "var": "--k-sys",     "dark": "#19f0ff", "job": "navigation: menu, camera, pager, pickers, tips, focus ring, comms edge" },
      "cmd":     { "var": "--k-cmd",     "dark": "#9a63ff", "job": "command and planning, cards, every LOCKED order" },
      "fire":    { "var": "--k-fire",    "dark": "#ff2b4e", "job": "the main action (the gun)" },
      "aim":     { "var": "--k-aim",     "dark": "#ff7389", "job": "aim modes; fire's lighter twin; dim when off" },
      "attack":  { "var": "--k-attack",  "dark": "#ff2e88", "job": "offensive order; door pink" },
      "advance": { "var": "--k-advance", "dark": "#ff8a1f", "job": "push to objective" },
      "fallin":  { "var": "--k-fallin",  "dark": "#a8ff3e", "job": "form up on the player" },
      "flag":    { "var": "--k-flag",    "dark": "#f6f3ff", "job": "white flag: pause / surrender; overlay sticker face" },
      "go":      { "var": "--k-go",      "dark": "#39ffb0", "job": "start and confirm; comms LED" },
      "teamA":   { "var": "--team-a",    "dark": "#39ffb0", "job": "side A: retreat key, badges, platoon keys" },
      "teamB":   { "var": "--team-b",    "dark": "#ff5c8f", "job": "side B" },
      "hurt":    { "var": "--hurt",      "dark": "#ffc21a", "job": "health 30-60%" },
      "critical":{ "var": "--critical",  "dark": "#f0506e", "job": "health under 30%; alert" }
    },
    "inks": {
      "sysInk":  { "var": "--k-sys-ink",  "dark": "= sys", "light": "#006e91" },
      "cmdInk":  { "var": "--k-cmd-ink",  "dark": "#b48cff", "light": "#6a3ae6" },
      "fireInk": { "var": "--k-fire-ink", "dark": "= fire", "light": "#c01033" }
    },
    "surfaces": {
      "bg":      { "var": "--bg",      "dark": "#07060f", "light": "#eef0fb" },
      "surface": { "var": "--surface", "dark": "#110d22", "light": "#ffffff" },
      "raised":  { "var": "--raised",  "dark": "#1d1738", "light": "#e6e4f8" },
      "card":    { "var": "--card",    "dark": "#120f26", "light": "#ffffff" },
      "ink":     { "var": "--ink",     "dark": "#f6f3ff", "light": "#1b1636" },
      "muted":   { "var": "--muted",   "dark": "#aea4d6", "light": "#5d5684" },
      "line":    { "var": "--line",    "dark": "#3b3170", "light": "#b9b2e3" },
      "rim":     { "var": "--rim",     "dark": "#07060f", "light": "#07060f", "note": "same in both themes: every key, sticker and card sits on an ink rim" }
    },
    "derived": {
      "--k-cmd-base": "color-mix(in srgb, var(--k-cmd) 50%, var(--rim))",
      "--k-cmd-deep": "color-mix(in srgb, var(--k-cmd) 80%, var(--rim))",
      "--bui-kbd-alpha": "0.88",
      "key edge (arcade)": "color-mix(in srgb, var(--c) 45%, var(--bui-shadow))",
      "glow rest / hover / press": "0 0 14u / 18u / 22u, var(--c) at 40% / 55% / 70% (none on light)"
    }
  },
  "grid": {
    "note": "The hero grid (fizlet.com: every hero; site/site.css GRID block). Exported for Battlefield, Blitz and DOM VIRUS to reuse; not yet in board-ui.css. Lines every size, line px wide, in ink; the band fades out with fade.",
    "size": "44px",
    "line": "1px",
    "ink": { "dark": "color-mix(in srgb, var(--k-sys) 9%, transparent)", "light": "color-mix(in srgb, var(--k-cmd) 9%, transparent)" },
    "band": "560px",
    "fade": "linear-gradient(#000 35%, transparent)",
    "css": "linear-gradient(var(--grid-ink) var(--grid-line), transparent var(--grid-line)) 0 0 / var(--grid-size) var(--grid-size), linear-gradient(90deg, var(--grid-ink) var(--grid-line), transparent var(--grid-line)) 0 0 / var(--grid-size) var(--grid-size)"
  },
  "units": {
    "u": { "desktop": "1px", "phone": "clamp(0.7px, min(100dvh / 390, 100dvw / 844), 1.3px)", "phone-fullscreen-desk-touch": "1.5px", "design": "844 x 390 phone landscape" }
  },
  "shadow": {
    "note": "The domain's, not the component's (BOARD-UI.md 4.1). A site sets --shadow-x / --shadow-y (unitless direction per unit of depth) and --shadow-color once at its :root; the kit reads them through these aliases on .bui, whose fallbacks are the default. Every hard shadow is depth x direction; a press travels the same vector.",
    "page": { "x": "--shadow-x", "y": "--shadow-y", "color": "--shadow-color" },
    "aliases": {
      "--bui-sx": "var(--shadow-x, 0)",
      "--bui-sy": "var(--shadow-y, 1)",
      "--bui-shadow": "var(--shadow-color, var(--rim))"
    },
    "domains": {
      "default, DOM Battlefield, Blitz, fizlet.com": { "x": 0, "y": 1, "means": "straight below" },
      "DOM VIRUS hub": { "x": 1, "y": 1, "means": "45 degrees down-right" }
    }
  },
  "key": {
    "base": { "py": "3u", "hy": "1u", "border": "2u", "radius": "6u", "minHeight": "40u", "padding": "8u 13u" },
    "arcade": { "py": "4u", "hy": "2u", "radius": "10u", "minHeight": "44u", "font": "700 12u mono", "border": "rim" },
    "sticker": { "py": "5u", "hy": "2u", "size": "132u x 84u", "border": "3u #f6f3ff", "radius": "12u", "icon": "42u", "label": "900 10u mono, 1.6u tracking" },
    "orb": { "desktop": "66u", "phone": "80u", "border": "3u cmd", "py": "5u", "caption": "900 9.5u mono" },
    "unit": { "size": "44u", "number": "900 16u mono", "pips": "6u, 3u gap" },
    "focus": "3u bg gap + 6u sys-ink ring, drawn on the face AND the base",
    "states": ["rest", "hover (fine pointer only)", "press (:active, .down)", "locked (aria-pressed|aria-expanded=true, .active)", "call (.bui-call)", "disabled"]
  },
  "motion": {
    "keyTravel": "transform + box-shadow 120ms ease-out; press 50ms",
    "locked": "breath 1.8s ease-in-out infinite",
    "call": "ring 1.4s ease-out infinite, from the bottom of the base",
    "slam": "1100ms: drop 0-36% (ease-in), hit, settle 46%, hold to 72%, press in to 100%",
    "launch": "press + invert 90ms, shatter 6 chunks + flash 320ms + core 460ms + ring 480ms + 12 bits 640ms, total 760ms",
    "surrender": "white-out 16 cells x 18ms steps(2), flag wave 120ms x4, then launch burst at 480ms",
    "bootDoors": "620ms rotateY ±100deg after 120ms; boot timeline offset t0 = 0.65s",
    "spring": "cubic-bezier(0.34, 1.7, 0.5, 1)",
    "out": "cubic-bezier(0.15, 0.8, 0.3, 1)"
  },
  "layout": {
    "touch": "(pointer: coarse) and (max-width: 1400px), (max-width: 759px)",
    "desktopBar": { "labelsWhen": "everything fits on one line", "iconsWhen": "docks + roster (52u per tank + 64u) > bar width, or more than 4 tanks below 1750px", "platoonCardWhen": "battle and (bar < 1180px, or more than 4 tanks below 1160px, or icons still don't fit)" },
    "fullScreenDock": { "header": "54u (title at 16u/21u, switch 28x24u at 12u/12u)", "padding": "54u 14u 14u", "gap": "12u" },
    "cardBuffer": "10px between floating cards",
    "toastHeaderBuffer": "header height + 12u"
  },
  "zIndex": {
    "field": "0-9", "cards": "13-16", "dock cards": "20", "comms toast": "22-34", "overlay": "30-33", "tips": "40", "gate": "50", "boot": "70", "stale lock": "80", "burst": "body, top"
  },
  "storage": {
    "theme": "dom-virus:theme",
    "perf overlay": "dom-virus:perf",
    "sound": "dom-virus:<game>:sound",
    "tips": "<game>:tips",
    "cards in battle": "<game>:battle-cards {fold, pin}",
    "dock icons": "<game>:dock",
    "roster layout": "<game>:roster",
    "door hand-off (session)": "dom-virus:doors = shut"
  }
}
